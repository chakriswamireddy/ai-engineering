# ============================================================
# AI LAYER — Environment Variables
# Copy to .env and fill in. NEVER commit real keys to Git.
# ============================================================

# ---------------------------------------------------------------------------
# Domain Configuration
# ---------------------------------------------------------------------------
DOMAIN=example.com

# ---------------------------------------------------------------------------
# LLM Providers (Day 4 — ModelGateway)
# At least one provider with API key is required.
# ---------------------------------------------------------------------------
# OpenRouter (OpenAI-compatible: chat + embeddings through one key)
# Get key from https://openrouter.ai/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Cloudflare Workers AI — embeddings only (free tier)
# Token: cfut_* from dash.cloudflare.com; account hex from URL
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# Provider chain: cloudflare first for embeddings, falls through to OpenRouter for chat
LLM_PROVIDERS=cloudflare:,openai:openai/gpt-4o-mini

# WS5 — self-hosted embeddings (no key, no $50-100/mo): Ollama bge-base-en-v1.5
# dim 768. Start the daemon, pull the model, then pin the chain to it:
#   ollama serve & ollama pull bge-base-en-v1.5
#   LLM_PROVIDERS=ollama: (embed via OLLAMA_EMBEDDING_MODEL, chat falls through)
# Paid tier alternative: keep cloudflare:/openai embeddings (see above).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-base-en-v1.5

# Fallback embedding model if Cloudflare is unreachable
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Embedding model for RAG
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# Gateway retry/timeout knobs
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_S=60
LLM_BASE_DELAY_S=1.0
LLM_MAX_DELAY_S=30.0
LLM_TOTAL_BUDGET_S=0

# ---------------------------------------------------------------------------
# RAG Stores (Day 6/10)
# ---------------------------------------------------------------------------
RAG_STORE_PATH=data/store.json
RAG_CODE_STORE_PATH=data/code_store.json

# ---------------------------------------------------------------------------
# Retrieval Knobs (Day 8/9)
# ---------------------------------------------------------------------------
TOOL_GATE_TAU=0.55
TOOL_TOP_K=5
TOOL_MAX_TURNS=6

# ---------------------------------------------------------------------------
# Agent Loop Bounds (Day 12/13/15/16)
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=6
AGENT_BUDGET_CHARS=12000
AGENT_SELF_CORRECT=2
AGENT_BUDGET_USD=0.50
AGENT_TOOL_TIMEOUT_S=30.0
AGENT_REPEAT_WINDOW=4
AGENT_TOOL_RETRIES=1
AGENT_FALLBACKS=1
AGENT_MAX_REPLANS=1
AGENT_MAX_REPAIRS=1

# ---------------------------------------------------------------------------
# Saleor Data Agent (Day 14) — Read-only PostgreSQL
# Uses the saleor_read_only role created by replica_user.sql
# ---------------------------------------------------------------------------
SALEOR_READONLY_DB_URL=postgres://saleor_read_only:saleor@db:5432/saleor
SALEOR_SQL_ROW_LIMIT=100
SALEOR_SQL_SCHEMA_BUDGET=4000
SALEOR_SQL_POLICY=policy.yaml

# ---------------------------------------------------------------------------
# State & Memory (Day 17/18/19)
# ---------------------------------------------------------------------------
STATE_STORE_PATH=data/state.json
STATE_DEFAULT_TTL=86400
STATE_MAX_RECORDS=1000
STATE_PRINCIPAL=default

MEMORY_ENABLED=1
MEMORY_RECALL_TOP_K=5
MEMORY_RECALL_TAU=0.55
MEMORY_MIN_SOURCES=2
MEMORY_DISTILL_TTL=604800
MEMORY_STRENGTH_DECAY=0.99

TOPOLOGY=single
ROLES=

# ---------------------------------------------------------------------------
# Evaluation (Day 20/21/22)
# ---------------------------------------------------------------------------
EVAL_JUDGE=deterministic

# ---------------------------------------------------------------------------
# Observability (Day 23/24)
# ---------------------------------------------------------------------------
AI_TRACING=1
TRACE_PROPAGATION=1
TRACE_METRICS=1
TRACE_LOGGING=1
TRACE_INGEST=0

# WS7 — durable trace sink + retention (S6 window queries survive restarts).
# file (default when set; data/traces.jsonl, no dependency) | postgres
# (TimescaleDB via TRACE_SINK_DSN) | off. Unset = memory ring only (offline).
# TRACE_SINK=
# TRACE_SINK_PATH=data/traces.jsonl
# TRACE_SINK_DSN=postgres://ai:ai@db:5432/ai
# TRACE_RETENTION_DAYS=30 (raw; aggregates live 90d in Prometheus)

# ---------------------------------------------------------------------------
# Injection Firewall (Day 25)
# ---------------------------------------------------------------------------
INJECTION_ENABLED=1

# ---------------------------------------------------------------------------
# Permissions (Day 26)
# ---------------------------------------------------------------------------
PERMISSIONS_PATH=permissions.yaml
PERMISSIONS=on
AGENT_PRINCIPAL=default
AUDIT_LOG_PATH=data/audit.jsonl

# ---------------------------------------------------------------------------
# Approvals / Human-in-the-loop (Day 27)
# ---------------------------------------------------------------------------
APPROVALS_PATH=data/approvals.json
APPROVALS=on
APPROVAL_TTL_S=900
APPROVAL_MAX_PER_RUN=1
APPROVAL_EXECUTOR_PRINCIPAL=executor

# ---------------------------------------------------------------------------
# Production Architecture (Day 28)
# ---------------------------------------------------------------------------
CAPACITY_PATH=capacity.yaml
RATE_LIMIT=none
STORE_CACHE=1

# ---------------------------------------------------------------------------
# Survive (WS9) — deploy / secrets / rate / DR knobs
# ---------------------------------------------------------------------------
# Per-tenant/principal token bucket; RATE_LIMIT_RPS=none|unset = disabled
# (offline suites never 429). Redis shared across replicas when REDIS_URL set.
# Production values (TRACE_SINK / RATE_LIMIT_RPS / AUDIT_SEAL_PATH) live in the
# ROOT .env, not here — _load_dotenv() reads this file into os.environ, so a
# deployment value here would also apply to the offline suite.
# RATE_LIMIT_RPS=none
# RATE_LIMIT_BURST=10
# Postgres advisory lock for the one-writer rule across replicas (falls back
# to the Day-29 file lock when unset/unreachable).
# STATE_ADVISORY_DSN=postgres://ai:ai@db:5432/ai
# External seal of the audit chain tail (KMS-backed object in staging) —
# detects tail truncation verify() cannot see. Seal after every backup.
# AUDIT_SEAL_PATH=data/audit.seal

# ---------------------------------------------------------------------------
# Test Execution Sandbox (WS8) — isolated, last
# ---------------------------------------------------------------------------
# subprocess (default, no dependency) | docker (needs SANDBOX_IMAGE).
# AI_OS_SANDBOX=subprocess
# SANDBOX_IMAGE=python:3.12-slim
# SANDBOX_CPU_S=300

# ---------------------------------------------------------------------------
# Deployment (Day 29)
# ---------------------------------------------------------------------------
AI_OS_IMAGE=ai-layer:latest
AI_OS_HEALTH_TIMEOUT_S=30
AI_OS_LOCK_STATE=1

# ---------------------------------------------------------------------------
# Identity / OIDC (WS1) — who is asking, verified
# ---------------------------------------------------------------------------
# OIDC issuer + audience (production). JWKS defaults to
# {issuer}/.well-known/jwks.json; override with OIDC_JWKS_URL if custom.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# HS256 test/dev secret (offline tests, local dev ONLY — never production).
OIDC_TEST_SECRET=
# HS256 shared secret for deployments with no IdP. This is the production
# verifier: tokens are minted with `python tools/mint_token.py` (generate a
# value with `--gen-secret`) and checked with the same key. Set it together
# with ALLOW_ANON=0 — a locked door with no key locks you out too.
OIDC_HS256_SECRET=
# Anonymous access on guarded routes (/chat, /rag, /ledger, /metrics, /logs,
# /traces, /audit, /approvals/*, /ingest/span, /agent, /sql).
# Default 1 keeps offline suites green; production sets 0.
ALLOW_ANON=1

# ---------------------------------------------------------------------------
# Orchestration (Day 19)
# ---------------------------------------------------------------------------
MAX_DELEGATIONS=3
DELEGATION_RETRY=1
HANDOFF_TIMEOUT=30